---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";

interface Props {
    project: CollectionEntry<"projects">;
    Content: any;
}

const { project, Content } = Astro.props;
const { title, description, tags, status, pubDate } = project.data;

// Get other projects for related section
const allProjects = await getCollection("projects");
const otherProjects = allProjects
    .filter((p) => p.id !== project.id)
    .sort(() => Math.random() - 0.5)
    .slice(0, 4);
---

<div class="project-detail">
    <!-- Hero Section -->
    <section class="hero-section">
        <div class="container">
            <a href="/projects" class="back-link">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path d="M19 12H5M12 19l-7-7 7-7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                </svg>
                <span>Back to Projects</span>
            </a>

            <h1 class="project-title">{title}</h1>
            <p class="project-description">{description}</p>

            {tags && tags.length > 0 && (
                <div class="tags-list">
                    {tags.map((tag) => <span class="tag">{tag}</span>)}
                </div>
            )}

            <div class="meta-info">
                <div class="meta-item">
                    <span class="meta-label">YEAR</span>
                    <span class="meta-value">{new Date(pubDate).getFullYear()}</span>
                </div>
                <div class="meta-item">
                    <span class="meta-label">STATUS</span>
                    <span class="meta-value status-badge">{status}</span>
                </div>
                <div class="meta-item">
                    <span class="meta-label">ROLE</span>
                    <span class="meta-value">UX Designer / Developer</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Cover Image Section -->
    {project.data.cover && (
        <section class="cover-section">
            <div class="container">
                <div class="project-image">
                    <img src={project.data.cover} alt={title} />
                </div>
            </div>
        </section>
    )}

    <!-- Content Section -->
    <section class="content-section">
        <div class="container">
            <article class="content">
                <Content />
            </article>
        </div>
    </section>

    <!-- Related Projects Grid -->
    <div class="related-projects-section">
        <div class="projects-grid">
            {otherProjects.map((relatedProject) => {
                let imageContent;
                if (relatedProject.data.cover) {
                    imageContent = (
                        <img src={relatedProject.data.cover} alt={relatedProject.data.title} />
                    );
                } else {
                    imageContent = <div class="placeholder-image" />;
                }

                return (
                    <a href={`/projects/${relatedProject.id}`} class="project-card">
                        <div class="card-image">{imageContent}</div>
                        <div class="card-overlay">
                            <h3 class="project-title-card">{relatedProject.data.title}</h3>
                            <p class="project-preview">{relatedProject.data.description}</p>
                        </div>
                    </a>
                );
            })}
        </div>

        <div class="back-button-container">
            <a href="/projects" class="back-button">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path d="M19 12H5M12 19l-7-7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                Back to all projects
            </a>
        </div>
    </div>
</div>

<style>
    @import url("https://fonts.googleapis.com/css2?family=Archivo:wght@300;400;500;600;700;800;900&family=Archivo+Black&display=swap");

    .project-detail {
        background: #fff6f5;
        min-height: 100vh;
        font-family: "Archivo", sans-serif;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    /* ===== HERO SECTION ===== */
    .hero-section {
        background: linear-gradient(135deg, #093354 0%, #0a4a6b 100%);
        padding: 8rem 0 5rem;
        position: relative;
        overflow: hidden;
    }

    .hero-section::before {
        content: "";
        position: absolute;
        top: -50%;
        right: -10%;
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(228, 99, 84, 0.15) 0%, transparent 70%);
        border-radius: 50%;
        filter: blur(60px);
        animation: float 20s ease-in-out infinite;
    }

    @keyframes float {
        0%, 100% { transform: translate(0, 0); }
        50% { transform: translate(-50px, 50px); }
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        color: #e46354;
        background: rgba(228, 99, 84, 0.1);
        text-decoration: none;
        font-size: 0.9375rem;
        font-weight: 700;
        padding: 0.75rem 1.5rem;
        border-radius: 50px;
        border: 2px solid rgba(228, 99, 84, 0.2);
        margin-bottom: 3rem;
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        position: relative;
        z-index: 1;
    }

    .back-link:hover {
        background: rgba(228, 99, 84, 0.2);
        border-color: #e46354;
        transform: translateX(-5px);
        color: #fff6f5;
    }

    .back-link svg {
        transition: transform 0.3s ease;
    }

    .back-link:hover svg {
        transform: translateX(-3px);
    }

    .project-title {
        font-family: "Archivo Black", sans-serif;
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        line-height: 1.05;
        color: #fff6f5;
        margin: 0 0 1.5rem 0;
        letter-spacing: -0.02em;
        position: relative;
        z-index: 1;
    }

    .project-description {
        font-size: clamp(1.125rem, 2vw, 1.375rem);
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.85);
        margin: 0 0 2.5rem 0;
        max-width: 900px;
        position: relative;
        z-index: 1;
    }

    .tags-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 3.5rem;
        position: relative;
        z-index: 1;
    }

    .tag {
        font-size: 0.875rem;
        font-weight: 700;
        color: #e46354;
        background: rgba(228, 99, 84, 0.15);
        padding: 0.65rem 1.25rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-radius: 50px;
        border: 2px solid rgba(228, 99, 84, 0.3);
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .tag:hover {
        background: rgba(228, 99, 84, 0.25);
        border-color: #e46354;
        transform: translateY(-2px);
    }

    .meta-info {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        padding: 2.5rem 0 0;
        border-top: 2px solid rgba(255, 255, 255, 0.1);
        position: relative;
        z-index: 1;
    }

    .meta-item {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .meta-label {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        color: rgba(255, 255, 255, 0.5);
        text-transform: uppercase;
    }

    .meta-value {
        font-size: 1.125rem;
        font-weight: 700;
        color: #fff6f5;
    }

    .status-badge {
        display: inline-block;
        padding: 0.5rem 1.25rem;
        background: #b8d8ba;
        color: #093354;
        border-radius: 50px;
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        width: fit-content;
    }

    /* ===== COVER SECTION ===== */
    .cover-section {
        padding: 5rem 0;
        background: #fff6f5;
    }

    .project-image {
        width: 100%;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(9, 51, 84, 0.12), 0 0 0 1px rgba(9, 51, 84, 0.05);
        transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .project-image:hover {
        transform: translateY(-10px);
        box-shadow: 0 30px 80px rgba(9, 51, 84, 0.18), 0 0 0 1px rgba(9, 51, 84, 0.08);
    }

    .project-image img {
        width: 100%;
        height: auto;
        display: block;
        transition: transform 0.5s ease;
    }

    .project-image:hover img {
        transform: scale(1.03);
    }

    /* Conetnts */
    .content-section {
        padding: 3rem 0 6rem;
        background: #fff6f5;
    }

    .content {
        font-size: 1.0625rem;
        line-height: 1.8;
        color: rgba(9, 51, 84, 0.85);
        max-width: 900px;
    }

    .content :global(h1),
    .content :global(h2) {
        font-family: "Archivo Black", sans-serif;
        font-size: clamp(2rem, 4vw, 2.75rem);
        line-height: 1.15;
        color: #093354;
        margin: 3.5rem 0 1.5rem 0;
        letter-spacing: -0.02em;
        position: relative;
        padding-left: 1.5rem;
    }

    .content :global(h2::before) {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 6px;
        background: linear-gradient(180deg, #e46354, #ff9a8c);
        border-radius: 3px;
    }

    .content :global(h3) {
        font-size: clamp(1.375rem, 3vw, 1.875rem);
        font-weight: 800;
        color: #093354;
        margin: 2.5rem 0 1rem 0;
        letter-spacing: -0.01em;
    }

    .content :global(h4) {
        font-size: 1.25rem;
        font-weight: 700;
        color: #093354;
        margin: 2rem 0 1rem 0;
    }

    .content :global(p) {
        margin: 0 0 1.5rem 0;
    }

    .content :global(ul),
    .content :global(ol) {
        padding-left: 2rem;
        margin: 2rem 0;
    }

    .content :global(li) {
        margin-bottom: 1rem;
        line-height: 1.8;
    }

    .content :global(ul li::marker) {
        color: #e46354;
    }

    .content :global(strong) {
        font-weight: 800;
        color: #e46354;
    }

    .content :global(a) {
        color: #e46354;
        font-weight: 700;
        text-decoration: none;
        border-bottom: 2px solid rgba(228, 99, 84, 0.3);
        transition: all 0.3s ease;
    }

    .content :global(a:hover) {
        color: #d94a3d;
        border-bottom-color: #e46354;
    }

    .content :global(img) {
        width: 100%;
        height: auto;
        border-radius: 16px;
        margin: 3rem 0;
        box-shadow: 0 15px 50px rgba(9, 51, 84, 0.1);
        transition: all 0.4s ease;
    }

    .content :global(img:hover) {
        transform: translateY(-5px);
        box-shadow: 0 20px 60px rgba(9, 51, 84, 0.15);
    }

    .content :global(hr) {
        border: none;
        height: 3px;
        background: linear-gradient(90deg, transparent, rgba(228, 99, 84, 0.3), transparent);
        margin: 4rem 0;
        border-radius: 2px;
    }

    .content :global(blockquote) {
        border-left: 4px solid #e46354;
        padding: 1.5rem 2rem;
        margin: 2rem 0;
        background: rgba(228, 99, 84, 0.05);
        border-radius: 0 12px 12px 0;
        font-style: italic;
        color: rgba(9, 51, 84, 0.9);
    }

    .content :global(code) {
        background: rgba(228, 99, 84, 0.1);
        color: #e46354;
        padding: 0.25rem 0.5rem;
        border-radius: 6px;
        font-size: 0.9em;
        font-family: "Courier New", monospace;
    }

    /*Related projects */
    .related-projects-section {
        padding: 0 0 0 0;
        margin: 0;
        width: 100%;
    }

    .projects-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0;
        width: 100%;
        margin: 0 auto;
        padding: 0;
        max-width: 1600px;
    }

    .project-card {
        display: block;
        position: relative;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        text-decoration: none;
        cursor: pointer;
        border: none;
        margin: 0;
        padding: 0;
        min-height: 300px;
    }

    .card-image {
        width: 100%;
        height: 100%;
        position: relative;
    }

    .card-image::before {
        content: "";
        position: absolute;
        inset: 0;
        background: rgba(9, 51, 84, 0.7);
        z-index: 1;
        transition: opacity 0.4s ease;
    }

    .project-card:hover .card-image::before {
        opacity: 0;
    }

    .card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .project-card:hover .card-image img {
        transform: scale(1.05);
    }

    .placeholder-image {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #e46354 0%, #d94a3d 100%);
    }

    .card-overlay {
        position: absolute;
        inset: 0;
        background: rgba(228, 99, 84, 0.85);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        opacity: 0;
        transition: opacity 0.4s ease;
        text-align: center;
        z-index: 2;
    }

    .project-card:hover .card-overlay {
        opacity: 1;
    }

    .project-title-card {
        font-size: clamp(1.25rem, 2vw, 1.75rem);
        font-weight: 900;
        color: rgb(9, 51, 84);
        margin: 0 0 1rem 0;
        letter-spacing: -0.02em;
        text-transform: uppercase;
    }

    .project-preview {
        font-size: clamp(0.9375rem, 1.2vw, 1.0625rem);
        color: rgba(9, 51, 84, 0.9);
        line-height: 1.6;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .back-button-container {
        padding: 3rem 1.5rem 4rem;
        text-align: center;
    }

    .back-button {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #e46354;
        text-decoration: none;
        font-size: 0.9375rem;
        font-weight: 700;
        padding: 0.75rem 1.5rem;
        background: rgba(228, 99, 84, 0.1);
        border: 2px solid rgba(228, 99, 84, 0.2);
        border-radius: 50px;
        transition: all 0.3s ease;
    }

    .back-button:hover {
        background: rgba(228, 99, 84, 0.2);
        border-color: #e46354;
        transform: translateX(-3px);
    }

    .back-button svg {
        transition: transform 0.3s ease;
    }

    .back-button:hover svg {
        transform: translateX(-3px);
    }

    /* Better respsive look */
    @media (min-width: 640px) {
        .hero-section {
            padding: 10rem 0 6rem;
        }

        .cover-section {
            padding: 6rem 0;
        }

        .content-section {
            padding: 4rem 0 7rem;
        }

        .meta-info {
            grid-template-columns: repeat(3, 1fr);
            gap: 3rem;
        }

        .projects-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 1024px) {
        .hero-section {
            padding: 12rem 0 7rem;
        }

        .container {
            padding: 0 2rem;
        }

        .cover-section {
            padding: 7rem 0;
        }

        .content-section {
            padding: 5rem 0 8rem;
        }

        .projects-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }
</style>