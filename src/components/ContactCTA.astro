---
// src/components/ContactCTA.astro
---

<section class="contact-section">
    <div class="contact-container">
        <!-- Big Background Text -->
        <div class="contact-bg-text" id="bgText">
            <span class="bg-word">LET'S</span>
            <span class="bg-word">TALK</span>
        </div>

        <div class="contact-content">
            <!-- Main Message -->
            <div class="contact-message">
                <h2 class="contact-title">
                    I am actively seeking <span class="highlight"
                        >internship opportunities</span
                    >
                    in visual design, front-end development, and user experience
                    (UX) for 2026.
                </h2>

                <p class="contact-subtitle">
                    If you have a project or team that values <strong
                        >visual quality, user experience, and engaging motion</strong
                    > — I'd love to hear from you!
                </p>
            </div>

            <!-- CTA Buttons -->
            <div class="contact-cta">
                <a href="mailto:ulrika.garisone@gmail.com" class="cta-primary">
                    <span class="cta-text">Say Hello</span>
                    <svg
                        class="cta-arrow"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                    >
                        <path
                            d="M5 12h14M15 8l4 4-4 4"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"></path>
                    </svg>
                </a>

                <div class="social-links">
                    <a
                        href="https://github.com/ulrikagarisone"
                        target="_blank"
                        rel="noopener"
                        class="social-link"
                    >
                        <span>GitHub</span>
                    </a>
                    <span class="social-divider">/</span>
                    <a
                        href="https://linkedin.com/in/ulrikagarisone"
                        target="_blank"
                        rel="noopener"
                        class="social-link"
                    >
                        <span>LinkedIn</span>
                    </a>
                </div>
            </div>

            <!-- Bottom Note -->
            <p class="contact-note">
                For general inquiries or to just say hello,<br />
                my inbox is always open.
            </p>
        </div>
    </div>
</section>

