---
// src/components/Hero.astro
import LogoSVG from "../assets/logoug.svg?raw";
---

<section class="hero">
    <!-- Subtle grid background -->
    <div class="hero__grid" aria-hidden="true"></div>

    <div class="hero__container">
        <div class="hero__logo-section">
            <div class="hero__logo" data-hero="logo" set:html={LogoSVG} />
        </div>

        <div class="hero__text-section">
            <!-- Name -->
            <div class="hero__name">
                <h1 class="hero__title">
                    <span class="name-word name-word--first">ULRIKA</span>
                    <span class="name-word name-word--last">GARISONE</span>
                </h1>
            </div>

            <!-- Description -->
            <div class="hero__description">
                <p>
                    UX researcher and creative developer based in Belgium,
                    blending behavior observation with motion-driven interaction
                    design.
                </p>
            </div>

            <!-- Buttons -->
            <div class="hero__buttons">
                <a
                    href="/portfolio/projects"
                    class="hero-btn hero-btn--primary"
                >
                    All Projects <span class="btn-arrow">→</span>
                </a>
                <a href="/portfolio/about" class="hero-btn hero-btn--secondary">
                    About Me <span class="btn-arrow">→</span>
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .hero {
        min-height: 100vh;
        background: #e46354;
        color: #093354;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4rem 1.5rem 2rem;
        position: relative;
        overflow: hidden;
    }

    /* Grid background */
    .hero__grid {
        position: absolute;
        inset: 0;
        background-image: linear-gradient(
                rgba(9, 51, 84, 0.02) 1px,
                transparent 1px
            ),
            linear-gradient(90deg, rgba(9, 51, 84, 0.02) 1px, transparent 1px);
        background-size: 50px 50px;
        opacity: 0;
        z-index: 0;
    }

    .hero__container {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 1600px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.25rem;
    }

    /* Logo */
    .hero__logo-section {
        width: 100%;
        max-width: 260px;
        opacity: 0;
        display: flex;
        justify-content: center;
    }

    .hero__logo {
        width: 100%;
        height: auto;
        cursor: pointer;
        transition: transform 0.3s ease;
    }

    .hero__logo:hover {
        transform: scale(1.02) rotate(1deg);
    }

    .hero__logo :global(svg) {
        width: 100%;
        height: auto;
        display: block;
    }

    .hero__logo :global(path) {
        stroke: #093354;
        stroke-width: 8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /* Text section */
    .hero__text-section {
        width: 100%;
        max-width: 550px;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .hero__name {
        width: 100%;
    }

    .hero__title {
        font-size: clamp(1.75rem, 9vw, 3.5rem);
        font-weight: 900;
        line-height: 0.9;
        text-transform: uppercase;
        letter-spacing: -0.03em;
        text-align: center;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .name-word {
        display: block;
        opacity: 0;
        transform: translateY(30px);
    }

    .name-word--first {
        color: #fff6f5;
        font-family: "Archivo Black", sans-serif;
    }

    .name-word--last {
        color: #093354;
        -webkit-text-stroke: 2px #e46354;
        margin-left: 0.5rem;
    }

    /* Description */
    .hero__description {
        width: 100%;
        opacity: 0;
        transform: translateY(30px);
    }

    .hero__description p {
        font-size: clamp(0.875rem, 2.3vw, 1.25rem);
        line-height: 1.5;
        color: #fff6f5;
        font-weight: 400;
        text-align: center;
        max-width: 480px;
        margin: 0 auto;
    }

    /* Buttons */
    .hero__buttons {
        display: flex;
        gap: 0.875rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 0;
        opacity: 0;
        transform: translateY(30px);
    }

    .hero-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        padding: 0.75rem 1.5rem;
        font-size: 0.9rem;
        font-weight: 700;
        text-decoration: none;
        border-radius: 50px;
        text-transform: capitalize;
        letter-spacing: 0.02em;
        transition: all 0.3s ease;
        white-space: nowrap;
    }

    .btn-arrow {
        transition: transform 0.3s ease;
        font-size: 0.95rem;
    }

    .hero-btn:hover .btn-arrow {
        transform: translateX(5px);
    }

    .hero-btn--primary {
        background: #093354;
        color: #e46354;
        border: none;
        font-size: 0.9rem;
    }

    .hero-btn--primary:hover {
        transform: scale(1.03);
    }

    .hero-btn--secondary {
        background: transparent;
        color: #093354;
        border: 2.5px solid #093354;
    }

    .hero-btn--secondary:hover {
        background: #093354;
        color: #fff6f5;
        transform: scale(1.03);
    }

    /* Tablet */
    @media (min-width: 48rem) {
        .hero {
            padding: 4rem 1.5rem 2rem;
        }

        .hero__container {
            gap: 2rem;
        }

        .hero__logo-section {
            max-width: 380px;
        }

        .hero__title {
            font-size: clamp(3rem, 8vw, 4.5rem);
        }

        .name-word--last {
            margin-left: 1.5rem;
        }

        .hero__text-section {
            gap: 1.5rem;
        }

        .hero__description p {
            font-size: 1.15rem;
        }

        .hero-btn {
            font-size: 0.875rem;
            padding: 0.75rem 1.5rem;
        }

        .hero__buttons {
            gap: 1rem;
        }
    }

    /* Desktop */
    @media (min-width: 64rem) {
        .hero {
            padding: 2rem 1.5rem;
        }

        .hero__container {
            flex-direction: row;
            align-items: center;
            justify-content: center;
            gap: 3rem;
        }

        .hero__logo-section {
            flex: 0 0 auto;
            max-width: 650px;
        }

        .hero__text-section {
            flex: 0 0 auto;
            max-width: 550px;
        }

        .hero__title {
            text-align: left;
            font-size: clamp(3.5rem, 6vw, 6rem);
            align-items: flex-start;
        }

        .name-word--last {
            margin-left: 2.5rem;
        }

        .hero__description p {
            text-align: left;
            margin-left: 2.5rem;
            font-size: 1.25rem;
        }

        .hero__buttons {
            justify-content: flex-start;
            margin-left: 2.5rem;
        }
    }

    @media (min-width: 87.5rem) {
        .hero__container {
            gap: 4rem;
        }

        .hero__logo-section {
            max-width: 750px;
        }

        .hero__title {
            font-size: clamp(4.5rem, 7vw, 7rem);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            animation: none !important;
            transition: none !important;
        }
    }
</style>

<script>
    import { gsap } from "gsap";

    function init() {
        const logoEl = document.querySelector('[data-hero="logo"]');
        if (!logoEl) {
            return;
        }

        const svg = logoEl.querySelector("svg");
        if (!svg) {
            return;
        }

        const paths = svg.querySelectorAll("path");

        // Prepare paths for stroke drawing
        paths.forEach((path) => {
            const length = path.getTotalLength();
            path.style.strokeDasharray = length;
            path.style.strokeDashoffset = length;
            path.style.fill = "none";
        });

        const tl = gsap.timeline({ defaults: { ease: "power2.out" } });

        tl.to(".hero__grid", {
            opacity: 1,
            duration: 0.6,
        })
            .to(
                ".hero__logo-section",
                {
                    opacity: 1,
                    duration: 0.4,
                },
                "-=0.3",
            )
            // Draw stroke line by line
            .to(
                paths,
                {
                    strokeDashoffset: 0,
                    duration: 2,
                    stagger: 0.15,
                    ease: "power1.inOut",
                },
                "-=0.2",
            )
            // THEN fill them in
            .to(
                paths,
                {
                    fill: "#093354",
                    duration: 0.6,
                    stagger: 0.08,
                    ease: "power2.out",
                },
                "-=0.3",
            )
            .to(
                ".name-word",
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.6,
                    stagger: 0.12,
                    ease: "power3.out",
                },
                "-=0.5",
            )
            .to(
                ".hero__description",
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.5,
                },
                "-=0.3",
            )
            .to(
                ".hero__buttons",
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.5,
                },
                "-=0.3",
            );

        // Logo click replay
        logoEl.addEventListener("click", () => {
            gsap.timeline()
                .to(paths, {
                    fill: "none",
                    duration: 0.3,
                })
                .to(paths, {
                    strokeDashoffset: (i, el) => {
                        return el.getTotalLength();
                    },
                    duration: 0.8,
                    stagger: {
                        each: 0.08,
                        from: "end",
                    },
                    ease: "power2.in",
                })
                .to(paths, {
                    strokeDashoffset: 0,
                    duration: 2,
                    stagger: 0.15,
                    ease: "power1.inOut",
                })
                .to(paths, {
                    fill: "#093354",
                    duration: 0.6,
                    stagger: 0.08,
                });
        });
    }

    init();
</script>
