---
// src/components/FeaturedWork.astro
interface Props {
    projects: any[];
}

const { projects } = Astro.props;
---

<section class="featured-work">
    <div class="container">
        <div class="section-header">
            <h2>Selected Work</h2>
            <a href="/projects" class="link-arrow">
                All Projects
                <svg width="20" height="20" viewBox="0 0 20 20">
                    <path
                        d="M5 10h10M11 6l4 4-4 4"
                        stroke="currentColor"
                        stroke-width="2"
                        fill="none"></path>
                </svg>
            </a>
        </div>

        <div class="archive-grid">
            {
                projects.map((project, i) => {
                    let year = "2024";
                    if (project.data.pubDate) {
                        year = project.data.pubDate.getFullYear();
                    }

                    let tags = "";
                    if (project.data.tags && project.data.tags.length > 0) {
                        tags = project.data.tags.slice(0, 2).join(" · ");
                    }

                    return (
                        <article class="archive-item" data-index={i}>
                            <a
                                href={`/projects/${project.slug}`}
                                class="archive-link"
                            >
                                <div class="archive-item__number">
                                    {String(i + 1).padStart(2, "0")}
                                </div>
                                <h3 class="archive-item__title">
                                    {project.data.title}
                                </h3>
                                <div class="archive-item__meta">
                                    <span>{year}</span>
                                    <span class="archive-item__tags">
                                        {tags}
                                    </span>
                                </div>
                            </a>

                            <div class="archive-teaser" data-teaser={i}>
                                <img
                                    src={project.data.image}
                                    alt={project.data.title}
                                    loading="lazy"
                                />
                                <div class="archive-teaser__label">
                                    View Project →
                                </div>
                            </div>
                        </article>
                    );
                })
            }
        </div>
    </div>
</section>
