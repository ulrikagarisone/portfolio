---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

// Import images directly
import visualDesignImg from "../assets/tools/visual-design.jpeg";
import webDevImg from "../assets/tools/web-dev.jpeg";
import uxResearchImg from "../assets/tools/ux-research.jpeg";
import motionImg from "../assets/tools/motion.jpeg";

// Create image map
const imageMap: Record<string, any> = {
    "visual-design.jpeg": visualDesignImg,
    "web-dev.jpeg": webDevImg,
    "ux-research.jpeg": uxResearchImg,
    "motion.jpeg": motionImg,
};

// Fetch skills from content collection
const allSkills = await getCollection("skills");
const sortedSkills = allSkills.sort((a, b) => a.data.order - b.data.order);
---

<section class="services-section">
    <div class="services-container">
        <div class="services-header">
            <h2 class="services-title">SKILLS & TOOLS</h2>
        </div>

        <div class="services-list">
            {
                sortedSkills.map((skill, index) => {
                    const number = String(index + 1).padStart(2, "0");
                    const skillImage = imageMap[skill.data.imagePath];

                    return (
                        <div class="service-item" data-number={number}>
                            <div class="service-main">
                                <span class="service-number">{number}</span>
                                <h3 class="service-name">{skill.data.title}</h3>
                                <button
                                    class="service-toggle"
                                    aria-label="Toggle details"
                                >
                                    <span class="toggle-icon">+</span>
                                </button>
                            </div>
                            <div class="service-details">
                                <div class="details-content">
                                    <ul class="service-features">
                                        {skill.data.tools.map((tool) => (
                                            <li>{tool}</li>
                                        ))}
                                    </ul>
                                    <p class="service-description">
                                        {skill.data.description}
                                    </p>
                                    <div class="service-image">
                                        <Image
                                            src={skillImage}
                                            alt={skill.data.title}
                                            width={300}
                                            height={400}
                                            loading="lazy"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                    );
                })
            }
        </div>
    </div>
</section>

<style>
    .services-section {
        background: #f5f5f5;
        padding: 4rem 0;
        position: relative;
    }

    .services-container {
        max-width: 100%;
        margin: 0 auto;
        padding: 0;
    }

    /* Header */
    .services-header {
        margin-bottom: 3rem;
        padding: 0 1.5rem;
        opacity: 0;
        animation: fadeIn 0.8s ease forwards;
    }

    @keyframes fadeIn {
        to {
            opacity: 1;
        }
    }

    .services-title {
        font-size: clamp(2rem, 5vw, 4rem);
        font-weight: 900;
        color: #093354;
        margin: 0;
        letter-spacing: -0.02em;
    }

    .services-list {
        display: flex;
        flex-direction: column;
    }

    .service-item {
        border-bottom: 2px solid rgba(9, 51, 84, 0.1);
        background: #f5f5f5;
        transition: background 0.3s ease;
        opacity: 0;
        transform: translateY(20px);
        animation: slideUp 0.6s ease forwards;
    }

    .service-item.active {
        background: #ffffff;
    }

    .service-item:nth-child(1) {
        animation-delay: 0.1s;
    }
    .service-item:nth-child(2) {
        animation-delay: 0.2s;
    }
    .service-item:nth-child(3) {
        animation-delay: 0.3s;
    }
    .service-item:nth-child(4) {
        animation-delay: 0.4s;
    }

    @keyframes slideUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .service-main {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.5rem 1.5rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .service-main:hover {
        padding-left: 2rem;
    }

    .service-number {
        font-size: clamp(0.875rem, 1.5vw, 1rem);
        font-weight: 900;
        color: rgba(9, 51, 84, 0.3);
        min-width: 2rem;
    }

    .service-name {
        flex: 1;
        font-size: clamp(1.5rem, 4vw, 2.5rem);
        font-weight: 900;
        color: #093354;
        margin: 0;
        letter-spacing: -0.02em;
        transition: color 0.3s ease;
    }

    .service-main:hover .service-name {
        color: #e46354;
    }

    .service-toggle {
        width: 2.5rem;
        height: 2.5rem;
        border: 2px solid #093354;
        border-radius: 50%;
        background: transparent;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
        flex-shrink: 0;
    }

    .service-toggle:hover {
        background: #e46354;
        border-color: #e46354;
        transform: rotate(90deg);
    }

    .toggle-icon {
        font-size: 1.25rem;
        font-weight: 300;
        color: #093354;
        transition: color 0.3s ease;
    }

    .service-toggle:hover .toggle-icon {
        color: #ffffff;
    }

    .service-item.active .toggle-icon {
        transform: rotate(45deg);
    }

    .service-item.active .service-toggle {
        background: #e46354;
        border-color: #e46354;
    }

    .service-item.active .toggle-icon {
        color: #ffffff;
    }

    .service-details {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
        background: #ffffff;
    }

    .service-item.active .service-details {
        max-height: 1000px;
    }

    /*  side-by-side image*/
    .details-content {
        padding: 2rem 2rem 3rem;
        display: grid;
        grid-template-columns: 1fr 120px;
        gap: 1.5rem;
        align-items: start;
    }

    .service-features {
        list-style: none;
        padding: 0;
        margin: 0;
        grid-column: 1;
        grid-row: 1;
    }

    .service-description {
        grid-column: 1 / -1;
        grid-row: 2;
    }

    .service-image {
        width: 120px;
        height: 150px;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        opacity: 0;
        transform: translateX(20px);
        transition: all 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
        grid-column: 2;
        grid-row: 1;
    }

    .service-item.active .service-image {
        opacity: 1;
        transform: translateX(0);
        transition-delay: 0.2s;
    }

    .service-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .service-features li {
        font-size: clamp(0.9375rem, 1.5vw, 1.0625rem);
        color: #093354;
        padding: 0.5rem 0;
        position: relative;
        padding-left: 1.5rem;
        font-weight: 500;
    }

    .service-features li::before {
        content: "/";
        position: absolute;
        left: 0;
        color: #e46354;
        font-weight: 700;
    }

    .service-description {
        font-size: clamp(1rem, 1.7vw, 1.25rem);
        line-height: 1.8;
        color: rgba(9, 51, 84, 0.8);
        margin: 0;
    }

    /* Desktop */
    @media (min-width: 64rem) {
        .services-section {
            padding: 10rem 0;
        }

        .services-header {
            margin-bottom: 5rem;
            padding: 0 clamp(2rem, 5vw, 6rem);
        }

        .service-main {
            gap: 2rem;
            padding: 2rem clamp(2rem, 5vw, 6rem);
        }

        .service-main:hover {
            padding-left: calc(clamp(2rem, 5vw, 6rem) + 1rem);
        }

        .service-number {
            min-width: 3rem;
        }

        .service-toggle {
            width: 3rem;
            height: 3rem;
        }

        .toggle-icon {
            font-size: 1.5rem;
        }

        .details-content {
            grid-template-columns: 1fr 1.5fr 1fr;
            gap: 3rem;
            padding: 2rem clamp(2rem, 5vw, 6rem) 3rem;
        }

        .service-features {
            grid-column: 1;
            grid-row: auto;
        }

        .service-description {
            grid-column: 2;
            grid-row: auto;
        }

        .service-image {
            width: 100%;
            height: 300px;
            grid-column: 3;
            grid-row: auto;
        }
    }
</style>

<script>
    const init = () => {
        const items = document.querySelectorAll(".service-item");

        items.forEach((item) => {
            const main = item.querySelector(".service-main");

            if (main) {
                main.addEventListener("click", () => {
                    // Close other items
                    items.forEach((other) => {
                        if (other !== item) {
                            other.classList.remove("active");
                        }
                    });

                    // Toggle current item
                    item.classList.toggle("active");
                });
            }
        });
    };

    init();
</script>
