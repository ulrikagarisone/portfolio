---
// src/components/=StoryTimeline.astro
---

<section class="about-story">
    <!-- Panel 1left side -->
    <div class="story-panel panel-left">
        <div class="panel-side panel-image">
            <img
                src=""
                alt="The Beginning"
            />
            <div class="image-overlay"></div>
        </div>
        <div class="panel-side panel-content">
            <span class="panel-number">01</span>
            <h3 class="panel-title">The Beginning</h3>
            <p class="panel-text">
                My journey started with motion, competition, and curiosity.
                Sport taught me that <strong>creativity is a muscle</strong> — you
                train it daily. Now I channel that discipline into creating interactive
                experiences where design meets code.
            </p>
        </div>
    </div>

    <!-- Panel 2 right side -->
    <div class="story-panel panel-right">
        <div class="panel-side panel-content">
            <span class="panel-number">02</span>
            <h3 class="panel-title">The Craft</h3>
            <p class="panel-text">
                I experiment with motion, visuals, and interaction — creating
                digital moments that feel <strong>alive and seamless</strong>.
                From playful front-end experiments to meaningful visual systems.
            </p>
        </div>
        <div class="panel-side panel-image">
            <img
                src=""
                alt="The Craft"
            />
            <div class="image-overlay"></div>
        </div>
    </div>

    <!-- Panel 3 left side -->
    <div class="story-panel panel-left">
        <div class="panel-side panel-image">
            <img
                src="https://images.unsplash.com/photo-1502139214982-d0ad755818d8?w=800"
                alt="The Process"
            />
            <div class="image-overlay"></div>
        </div>
        <div class="panel-side panel-content">
            <span class="panel-number">03</span>
            <h3 class="panel-title">The Process</h3>
            <p class="panel-text">
                I find inspiration everywhere — sketching on paper, iterating in
                code, always looking for those <strong
                    >small details that elevate</strong
                >
                experience. Every pixel matters, every interaction tells a story.
            </p>
        </div>
    </div>

    <!-- Custom Portrait Cursor (Desktop Only) -->
    <div class="portrait-cursor" id="portraitCursor">
        <div class="cursor-frame">
            <img src="/images/try.jpeg" alt="Ulrika" />
        </div>
        <span class="cursor-label">I'm Ulrika</span>
    </div>
</section>

