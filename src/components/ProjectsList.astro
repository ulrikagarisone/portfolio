---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
    projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
---

<div class="projects-page">
    <header class="page-header">
        <h1>PROJECTS</h1>
        <p class="subtitle">
            A collection of my design and development work — from UX research to
            interactive experiences.
        </p>
    </header>

    <div class="projects-grid">
        {
            projects.map((project) => {
                let imageContent;

                if (project.data.cover) {
                    imageContent = (
                        <Image
                            src={project.data.cover}
                            alt={project.data.title}
                            width={800}
                            height={800}
                            loading="lazy"
                        />
                    );
                } else {
                    imageContent = <div class="placeholder-image" />;
                }

                return (
                    <a
                        href={`/portfolio/projects/${project.id}`}
                        class="project-card"
                    >
                        <div class="card-image">{imageContent}</div>
                        <div class="card-overlay">
                            <h3 class="project-title">{project.data.title}</h3>
                            <p class="project-preview">
                                {project.data.description}
                            </p>
                        </div>
                    </a>
                );
            })
        }
    </div>
</div>

<style>
    .projects-page {
        background: #093354;
        padding: 4rem 0 0 0;
        min-height: 100vh;
        margin: 0;
        max-width: 100%;
        width: 100%;
    }

    .page-header {
        text-align: center;
        margin-bottom: 3rem;
        padding: 0 0.75rem;
    }

    .page-header h1 {
        font-size: clamp(3rem, 8vw, 4rem);
        color: #fff6f5;
        margin: 0 0 1.5rem 0;
        font-weight: 900;
        letter-spacing: -0.02em;
    }

    .subtitle {
        font-size: clamp(1rem, 1.7vw, 1.25rem);
        color: rgba(255, 255, 255, 0.7);
        line-height: 1.6;
        max-width: 700px;
        margin: 0 auto;
    }
    .projects-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        width: 100%;
        margin: 0 auto;
        padding: 0;
        max-width: 1600px;
    }

    .project-card {
        display: block;
        position: relative;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        text-decoration: none;
        cursor: pointer;
        border: none;
        margin: 0;
        padding: 0;
    }

    .card-image {
        width: 100%;
        height: 100%;
        position: relative;
    }

    .card-image::before {
        content: "";
        position: absolute;
        inset: 0;
        background: rgba(9, 51, 84, 0.7);
        z-index: 1;
        transition: opacity 0.4s ease;
    }

    .project-card:hover .card-image::before {
        opacity: 0;
    }

    .card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .project-card:hover .card-image img {
        transform: scale(1.05);
    }

    .placeholder-image {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #e46354 0%, #d94a3d 100%);
    }

    /*Hoover overlay */
    .card-overlay {
        position: absolute;
        inset: 0;
        background: rgba(228, 99, 84, 0.85);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        opacity: 0;
        transition: opacity 0.4s ease;
        text-align: center;
        z-index: 2;
    }

    .project-card:hover .card-overlay {
        opacity: 1;
    }

    .project-title {
        font-size: clamp(1.125rem, 2vw, 1.75rem);
        font-weight: 900;
        color: rgb(9, 51, 84);
        margin: 0 0 1rem 0;
        letter-spacing: -0.02em;
        text-transform: uppercase;
    }

    .project-preview {
        font-size: clamp(0.9375rem, 1.2vw, 1.125rem);
        color: rgba(9, 51, 84, 0.9);
        line-height: 1.6;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    /* Smaller screen so it resizes to 2 columns */
    @media (min-width: 40rem) {
        .projects-page {
            padding: 6rem 0 0 0;
        }

        .page-header {
            padding: 0 1rem;
        }

        .projects-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 1024px) {
        .projects-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }
</style>
