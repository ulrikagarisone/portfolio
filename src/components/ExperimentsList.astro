---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
    experiments: CollectionEntry<"experiments">[];
}

const { experiments } = Astro.props;
---

<div class="experiments-page">
    <header class="page-header">
        <h1>EXPERIMENTS</h1>
        <p class="subtitle">
            A mix of small creative studies. UX notes, motion trials, and p5.js
            mini-projects that help me explore new ideas.
        </p>
    </header>

    <div class="experiments-grid">
        {
            experiments.map((experiment) => {
                let imageContent;
                if (experiment.data.cover) {
                    imageContent = (
                        <Image
                            src={experiment.data.cover}
                            alt={experiment.data.title}
                            width={600}
                            height={600}
                            loading="lazy"
                        />
                    );
                } else {
                    imageContent = <div class="placeholder-image" />;
                }

                return (
                    <a
                        href={`${import.meta.env.BASE_URL}experiments/${experiment.id}`}
                        class="experiment-card"
                    >
                        <div class="card-image">{imageContent}</div>
                        <div class="card-overlay">
                            <h3 class="experiment-title">
                                {experiment.data.title}
                            </h3>
                            <p class="experiment-preview">
                                {experiment.data.description}
                            </p>
                        </div>
                    </a>
                );
            })
        }
    </div>
</div>

<style>
    .experiments-page {
        background: #fff6f5;
        padding: 4rem 0 0 0;
        min-height: 100vh;
        margin: 0;
        max-width: 100%;
        width: 100%;
    }

    .page-header {
        text-align: center;
        margin-bottom: 3rem;
        padding: 0 0.75rem;
    }

    .page-header h1 {
        font-size: clamp(3rem, 8vw, 4rem);
        color: #093354;
        margin: 0 0 1.5rem 0;
        font-weight: 900;
        letter-spacing: -0.02em;
    }

    .subtitle {
        font-size: clamp(1.125rem, 2vw, 1.375rem);
        color: rgba(9, 51, 84, 0.7);
        line-height: 1.6;
        max-width: 700px;
        margin: 0 auto;
    }

    .experiments-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        width: 100%;
        margin: 0 auto;
        padding: 0;
        max-width: 1600px;
    }

    .experiment-card {
        display: block;
        position: relative;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        text-decoration: none;
        cursor: pointer;
        border: none;
        margin: 0;
        padding: 0;
    }

    .card-image {
        width: 100%;
        height: 100%;
        position: relative;
    }

    .card-image::before {
        content: "";
        position: absolute;
        inset: 0;
        background: rgba(255, 246, 245, 0.6);
        z-index: 1;
        transition: opacity 0.4s ease;
    }

    .experiment-card:hover .card-image::before {
        opacity: 0;
    }

    .card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .experiment-card:hover .card-image img {
        transform: scale(1.05);
    }

    .placeholder-image {
        width: 100%;
        height: 100%;
        background: rgb(226, 212, 211);
    }

    /* Hover overlay */
    .card-overlay {
        position: absolute;
        inset: 0;
        background: rgba(255, 246, 245, 0.92);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        opacity: 0;
        transition: opacity 0.4s ease;
        text-align: center;
        z-index: 2;
    }

    .experiment-card:hover .card-overlay {
        opacity: 1;
    }

    .experiment-title {
        font-size: clamp(1.25rem, 2vw, 1.75rem);
        font-weight: 900;
        color: rgb(9, 51, 84);
        margin: 0 0 1rem 0;
        letter-spacing: -0.02em;
        text-transform: uppercase;
    }

    .experiment-preview {
        font-size: clamp(0.9375rem, 1.2vw, 1.0625rem);
        color: rgba(9, 51, 84, 0.85);
        line-height: 1.6;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Responsive */
    @media (min-width: 40rem) {
        .experiments-page {
            padding: 6rem 0 0 0;
        }

        .page-header {
            padding: 0 1rem;
        }

        .experiments-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 1024px) {
        .experiments-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }
</style>
