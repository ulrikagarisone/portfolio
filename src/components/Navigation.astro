---
const currentPath = Astro.url.pathname;

const links = [
    { href: "/", label: "Home", exact: true },
    { href: "/about", label: "About", exact: true },
    { href: "/projects", label: "Projects", exact: false },
    { href: "/experiments", label: "Experiments", exact: false },
];

function isActive(href: string, exact: boolean): boolean {
    if (exact) {
        return currentPath === href;
    } else {
        return currentPath.startsWith(href);
    }
}
---

<svg style="display:none">
    <symbol id="navicon" viewBox="0 0 24 24" fill="currentColor">
        <path
            d="M21 11h-18c-0.6 0-1 0.4-1 1s0.4 1 1 1h18c0.6 0 1-0.4 1-1s-0.4-1-1-1z"
        ></path>
        <path
            d="M3 7h18c0.6 0 1-0.4 1-1s-0.4-1-1-1h-18c-0.6 0-1 0.4-1 1s0.4 1 1 1z"
        ></path>
        <path
            d="M21 17h-18c-0.6 0-1 0.4-1 1s0.4 1 1 1h18c0.6 0 1-0.4 1-1s-0.4-1-1-1z"
        ></path>
    </symbol>
    <symbol id="close" viewBox="0 0 24 24" fill="currentColor">
        <path
            d="M19.1,17.7L6.3,4.9c-.4-.4-1-.4-1.4,0s-.4,1,0,1.4l12.7,12.7c.4.4,1,.4,1.4,0s.4-1,0-1.4Z"
        ></path>
        <path
            d="M6.3,19.1l12.7-12.7c.4-.4.4-1,0-1.4s-1-.4-1.4,0l-12.7,12.7c-.4.4-.4,1,0,1.4s1,.4,1.4,0Z"
        ></path>
    </symbol>
</svg>

<nav class="nav">
    <h1 class="nav__title">
        <a href="/">UG</a>
    </h1>
    <button
        class="nav__button hidden"
        aria-label="Navigation menu"
        aria-expanded="false"
        aria-controls="nav__list">
        <svg role="img" aria-labelledby="svg-title" focusable="false">
            <title id="svg-title">Menu</title>
            <use id="iconlink" xlink:href="#navicon"></use>
        </svg>
    </button>
    <ul class="nav__list" id="nav__list">
        {
            links.map((link) => (
                <li class="nav__item">
                    <a
                        class:list={[
                            "nav__link",
                            { active: isActive(link.href, link.exact) },
                        ]}
                        href={link.href}>
                        {link.label}
                    </a>
                </li>
            ))
        }
    </ul>
</nav>

<style>
    .hidden {
        display: none;
    }

    .nav a:any-link {
        color: var(--navy);
        text-decoration: none;
    }

    .nav {
        margin: 1rem auto 2rem auto;
        max-width: 1200px;
        padding: 0 1.25rem;
        display: grid;
    }

    .nav--fixed {
        position: fixed;
        width: calc(100% - 2rem);
        top: 0;
        padding-top: 1rem;
        background-color: var(--cream);
        z-index: 100;
    }

    .nav__title {
        grid-row: 1;
        grid-column: 1;
        margin: 0;
        font-size: 1.5rem;
    }

    .nav__button {
        grid-row: 1;
        grid-column: 2;
        align-self: center;
        justify-self: end;
        border: none;
        margin: 0;
        padding: 0;
        font-size: 1rem;
        line-height: 1;
        background: transparent;
        appearance: none;
        color: var(--navy);
        cursor: pointer;
    }

    .nav__button svg {
        width: 1.5rem;
        height: 1.5rem;
    }

    .nav__list {
        grid-row: 2;
        grid-column: 1 / span 2;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .nav__item {
        border-top: solid 1px var(--navy);
    }

    .nav__item:last-of-type {
        border-bottom: solid 1px var(--navy);
    }

    .nav__link {
        display: block;
        text-align: center;
        padding: 0.75rem;
        transition: all 0.3s ease;
    }

    .nav__link:hover,
    .nav__link.active {
        background-color: var(--teal);
        color: var(--cream);
    }
</style>

<script>
    const initNavigation = () => {
        const navButton = document.querySelector(".nav__button");
        const navList = document.querySelector(".nav__list");
        const iconLink = document.querySelector("#iconlink");
        const nav = document.querySelector(".nav");
        const listItems = navList?.querySelectorAll("li a");

        if (!navButton || !navList || !iconLink || !nav || !listItems) {
            return;
        }

        navButton.classList.remove("hidden");
        navList.classList.add("hidden");

        const openNavigation = () => {
            navButton.setAttribute("aria-expanded", "true");
            iconLink.setAttribute("xlink:href", "#close");
            navList.classList.remove("hidden");
            nav.classList.add("nav--fixed");
        };

        const closeNavigation = () => {
            navButton.setAttribute("aria-expanded", "false");
            iconLink.setAttribute("xlink:href", "#navicon");
            navList.classList.add("hidden");
            nav.classList.remove("nav--fixed");
        };

        const toggleNavigation = () => {
            const open = navButton.getAttribute("aria-expanded");
            if (open === "false") {
                openNavigation();
            } else {
                closeNavigation();
            }
        };

        const handleBlur = () => {
            closeNavigation();
        };

        navButton.addEventListener("click", toggleNavigation);
        listItems[listItems.length - 1].addEventListener("blur", handleBlur);

        window.addEventListener("keyup", (e) => {
            if (e.key === "Escape") {
                (navButton as HTMLButtonElement).focus();
                closeNavigation();
            }
        });
    };

    initNavigation();
</script>
