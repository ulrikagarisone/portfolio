---
// src/components/HeroMe.astro
import { Image } from "astro:assets";
import heroImage from "../assets/about/me.jpeg";
---

<section class="hero-me">
    <div class="hero-me__container">
        <div class="hero-me__text-back" data-hero="text-back">
            <h1 class="hero-me__title-large">
                <span class="title-word">ULRIKA</span>
                <span class="title-word">GARISONE</span>
            </h1>
        </div>

        <div class="hero-me__image" data-hero="image">
            <Image
                src={heroImage}
                alt="Ulrika Garisone"
                width={450}
                height={550}
                loading="eager"
            />
        </div>

        <div class="hero-me__text-front" data-hero="text-front">
            <p class="hero-me__intro">Hi, I'm</p>
            <p class="hero-me__subtitle">
                A Latvian-born UX researcher and creative developer based in
                Belgium, blending behavior observation with motion-driven
                interaction design.
            </p>
        </div>
    </div>
</section>

<style>
    .hero-me {
        height: 400vh;
        background: #e46354;
        position: relative;
    }

    .hero-me__container {
        position: sticky;
        top: 0;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1.5rem;
        overflow: hidden;
    }

    /* Large text visible by default */
    .hero-me__text-back {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 1;
        opacity: 0.3;
        width: 100%;
    }

    .hero-me__title-large {
        line-height: 0.85;
        text-align: center;
        margin: 0;
    }

    .title-word {
        display: block;
        font-size: 3.5rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: -0.03em;
        color: #093354;
    }

    /* Image with grayscale effect */
    .hero-me__image {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 2;
        width: 240px;
        height: 300px;
        opacity: 0;
        border: 5px solid #093354;
        box-shadow: 0 25px 70px rgba(9, 51, 84, 0.4);
    }

    .hero-me__image::before {
        content: "";
        position: absolute;
        inset: 0;
        background: #182a47;
        opacity: 1;
        z-index: 1;
        mix-blend-mode: color;
        transition: opacity 0.4s ease;
        pointer-events: none;
    }

    .hero-me__image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        filter: brightness(1.1) contrast(1.1) saturate(0.8);
        transition: filter 0.4s ease;
    }

    /* Small text */
    .hero-me__text-front {
        position: absolute;
        bottom: 10%;
        left: 50%;
        transform: translateX(-50%);
        z-index: 3;
        text-align: center;
        width: 90%;
        max-width: 500px;
        opacity: 0;
    }

    .hero-me__intro {
        font-size: 1.5rem;
        font-weight: 700;
        color: #fff6f5;
        margin: 0 0 0.5rem 0;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        text-shadow: 2px 2px 8px rgba(9, 51, 84, 0.5);
    }

    .hero-me__subtitle {
        font-size: 0.95rem;
        line-height: 1.6;
        color: #fff6f5;
        font-weight: 500;
        margin: 0;
        text-shadow: 2px 2px 8px rgba(9, 51, 84, 0.5);
    }

    /* Tablet */
    @media (min-width: 48rem) {
        .title-word {
            font-size: 6rem;
        }

        .hero-me__image {
            width: 320px;
            height: 400px;
        }

        .hero-me__intro {
            font-size: 2rem;
        }

        .hero-me__subtitle {
            font-size: 1.15rem;
            max-width: 600px;
        }
    }

    /* Desktop */
    @media (min-width: 64rem) {
        .title-word {
            font-size: 10rem;
        }

        .hero-me__image {
            width: 400px;
            height: 500px;
        }

        .hero-me__intro {
            font-size: 2.5rem;
        }

        .hero-me__subtitle {
            font-size: 1.35rem;
            max-width: 700px;
        }
    }

    /* Large desktop */
    @media (min-width: 87.5rem) {
        .title-word {
            font-size: 14rem;
        }

        .hero-me__image {
            width: 450px;
            height: 550px;
        }

        .hero-me__intro {
            font-size: 3rem;
        }

        .hero-me__subtitle {
            font-size: 1.5rem;
            max-width: 800px;
        }
    }
</style>

<script>
    const init = () => {
        const section = document.querySelector(".hero-me") as HTMLElement;
        const textBack = document.querySelector(
            '[data-hero="text-back"]',
        ) as HTMLElement;
        const image = document.querySelector(
            '[data-hero="image"]',
        ) as HTMLElement;
        const textFront = document.querySelector(
            '[data-hero="text-front"]',
        ) as HTMLElement;
        const imageOverlay = image?.querySelector("::before");

        if (!section || !textBack || !image || !textFront) {
            return;
        }

        const handleScroll = () => {
            const rect = section.getBoundingClientRect();
            const sectionHeight = section.offsetHeight;
            const viewportHeight = window.innerHeight;

            const scrolled = -rect.top;
            const totalScrollDistance = sectionHeight - viewportHeight;
            let progress = Math.max(
                0,
                Math.min(1, scrolled / totalScrollDistance),
            );

            // Phase 1: Big text fades in fully (0% - 20%)
            if (progress <= 0.2) {
                const p = progress / 0.2;
                textBack.style.opacity = (0.3 + p * 0.7).toString();
            }
            // Phase 2: Image appears (20% - 40%)
            else if (progress <= 0.4) {
                textBack.style.opacity = "1";
                const imageProgress = (progress - 0.2) / 0.2;
                image.style.opacity = imageProgress.toString();
                const scale = 0.9 + imageProgress * 0.1;
                image.style.transform = `translate(-50%, -50%) scale(${scale})`;
            }
            // Phase 3: Image fully visible (40% - 55%)
            else if (progress <= 0.55) {
                textBack.style.opacity = "1";
                image.style.opacity = "1";
                image.style.transform = `translate(-50%, -50%) scale(1)`;
            }
            // Phase 4: Bottom text appears (55% - 70%)
            else if (progress <= 0.7) {
                textBack.style.opacity = "1";
                image.style.opacity = "1";
                const textProgress = (progress - 0.55) / 0.15;
                textFront.style.opacity = textProgress.toString();
                const textY = 20 - textProgress * 20;
                textFront.style.transform = `translateX(-50%) translateY(${textY}px)`;
            }
            // Phase 5: Everything visible - READING TIME (70% - 85%)
            else if (progress <= 0.85) {
                textBack.style.opacity = "1";
                image.style.opacity = "1";
                textFront.style.opacity = "1";
                textFront.style.transform = `translateX(-50%) translateY(0)`;
            }
            // Phase 6: Fade out (85% - 100%)
            else {
                const fadeProgress = (progress - 0.85) / 0.15;
                const opacity = 1 - fadeProgress;
                const moveY = -30 * fadeProgress;

                textBack.style.opacity = opacity.toString();
                textBack.style.transform = `translate(-50%, calc(-50% + ${moveY}px))`;
                image.style.opacity = opacity.toString();
                image.style.transform = `translate(-50%, calc(-50% + ${moveY}px)) scale(1)`;
                textFront.style.opacity = opacity.toString();
                textFront.style.transform = `translateX(-50%) translateY(${moveY}px)`;
            }
        };

        handleScroll();

        let ticking = false;
        window.addEventListener("scroll", () => {
            if (!ticking) {
                requestAnimationFrame(() => {
                    handleScroll();
                    ticking = false;
                });
                ticking = true;
            }
        });

        window.addEventListener("resize", handleScroll);
    };

    init();
</script>
