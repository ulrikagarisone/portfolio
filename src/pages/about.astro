---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About">
    <div class="container">
        <section class="about-hero section">
            <h1>About Me</h1>
            <p class="lead">
                I'm Ulrika Garisone, a Latvian-born digital designer & developer
                based in Belgium, studying at Howest.
            </p>
        </section>

        <section class="about-story section">
            <p>
                My journey started with motion, competition, and curiosity. A
                background in sport taught me that <strong
                    >creativity is a muscle</strong
                > — you train it daily. Now I channel that discipline into creating
                interactive experiences where design meets code, where micro-motion
                evokes emotion, and where user interactions feel alive.
            </p>

            <p>
                I enjoy experimenting with motion, visuals, and user interaction
                — from playful front-end experiments to meaningful visual
                systems. My goal is always to make digital moments that feel
                alive, personal, and seamless.
            </p>

            <p>
                Beyond design, I find inspiration in everyday stories, travel,
                color, and rhythm. I sketch ideas on paper, iterate in
                Illustrator, prototype in code — always looking for those small
                details that elevate experience.
            </p>
        </section>

        <!-- Skills -->
        <section class="skills section">
            <h2>What I Work With</h2>

            <div class="skills-grid">
                <div class="skill-category">
                    <h3>Design</h3>
                    <ul>
                        <li>Figma</li>
                        <li>Adobe Illustrator</li>
                        <li>Adobe Photoshop</li>
                        <li>Adobe After Effects</li>
                        <li>UI/UX Design</li>
                        <li>Prototyping</li>
                    </ul>
                </div>

                <div class="skill-category">
                    <h3>Development</h3>
                    <ul>
                        <li>HTML & CSS</li>
                        <li>JavaScript</li>
                        <li>PHP</li>
                        <li>Astro</li>
                        <li>React</li>
                        <li>Git & GitHub</li>
                    </ul>
                </div>

                <div class="skill-category">
                    <h3>Motion & Animation</h3>
                    <ul>
                        <li>CSS Animations</li>
                        <li>GSAP</li>
                        <li>P5.js</li>
                        <li>Micro-interactions</li>
                    </ul>
                </div>
            </div>
        </section>

        <section class="contact section">
            <h2>Work With Me</h2>

            <p class="lead-cta">
                I am actively seeking <strong>internship opportunities</strong> in
                front-end design, UX, and creative technology for next year. If you
                have a project or team that values <strong
                    >visual quality, user experience, and engaging motion</strong
                >, I'd love to hear from you!
            </p>
            <p>
                For general inquiries or to just say hello, my inbox is always
                open.
            </p>

            <div class="contact-links">
                <a href="mailto:ulrika.garisone@gmail.com" class="contact-link">
                    Say Hello
                </a>
                <a
                    href="https://github.com/ulrikagarisone"
                    target="_blank"
                    rel="noopener"
                    class="contact-link"
                >
                    GitHub
                </a>
                <a
                    href="https://linkedin.com/in/ulrikagarisone"
                    target="_blank"
                    rel="noopener"
                    class="contact-link"
                >
                    LinkedIn
                </a>
            </div>
        </section>
    </div>
</BaseLayout>

<style>
    .about-hero {
        text-align: center;
        margin-bottom: 3rem;
    }

    .about-hero h1 {
        color: var(--navy);
        margin-bottom: 1rem;
    }

    .lead {
        font-size: 1.25rem;
        line-height: 1.6;
        color: var(--teal);
    }
    /* About */
    .about-story {
        margin-bottom: 4rem;
    }

    .about-story p {
        font-size: 1.0625rem;
        line-height: 1.8;
        color: rgba(0, 0, 0, 0.85);
        margin-bottom: 1.5rem;
    }

    .about-story strong {
        color: var(--teal);
        font-weight: 700;
    }

    /* Skills */
    .skills {
        background: var(--white);
        border: 1px solid rgba(0, 0, 0, 0.08);
        padding: 2rem 1.5rem;
        margin-bottom: 4rem;
    }

    .skills h2 {
        color: var(--navy);
        text-align: center;
        margin-bottom: 2rem;
    }

    .skills-grid {
        display: grid;
        gap: 2rem;
    }

    .skill-category {
        padding-bottom: 1.5rem;
    }

    .skill-category:last-child {
        padding-bottom: 0;
    }

    .skill-category h3 {
        color: var(--teal);
        font-size: 1.125rem;
        margin-bottom: 1rem;
    }

    .skill-category ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .skill-category li {
        padding: 0.5rem 0;
        color: rgba(0, 0, 0, 0.8);
        border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    }

    .skill-category li:last-child {
        border-bottom: none;
    }

    /* Contact */
    .contact {
        background: var(--white);
        border: 1px solid rgba(0, 0, 0, 0.08);
        padding: 2rem 1.5rem;
        text-align: center;
    }

    .contact h2 {
        color: var(--navy);
        margin-bottom: 1.5rem;
    }

    .lead-cta {
        font-size: 1.125rem;
        line-height: 1.8;
        color: rgba(0, 0, 0, 0.85);
        margin-bottom: 1.5rem;
    }

    .lead-cta strong {
        color: var(--teal);
        font-weight: 700;
    }

    .contact p {
        color: rgba(0, 0, 0, 0.7);
        margin-bottom: 2rem;
    }

    .contact-links {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: center;
    }

    .contact-link {
        padding: 1rem 2rem;
        background: var(--teal);
        color: var(--cream);
        border-radius: 8px;
        font-weight: 700;
        transition: all 0.3s ease;
        width: 100%;
        max-width: 250px;
        text-align: center;
    }

    .contact-link:hover {
        transform: translateY(-2px);
        background: var(--navy);
    }
</style>
