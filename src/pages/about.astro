---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About">
    <section>
        <h2>About Me</h2>
        <p>
            I’m Ulrika Garisone, a Latvian-born digital designer and development
            student based in Belgium. I study Digital Design and Development at
            Howest University, where I explore the places where design,
            technology, and human experience meet.
        </p>
        <p>
            I enjoy experimenting with motion, visuals, and user interaction —
            from playful front-end experiments to meaningful visual systems. My
            goal is always to make digital moments that feel alive, personal,
            and seamless.
        </p>
        <p>
            Beyond design, I find inspiration in everyday stories, travel,
            color, and rhythm. Whether I’m sketching ideas on paper or building
            prototypes on screen, I look for small details that create emotional
            connection.
        </p>
    </section>
</BaseLayout>
