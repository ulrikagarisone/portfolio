---
import { getCollection, render } from "astro:content";
import MarkdownExperimentLayout from "../../layouts/MarkdownExperimentLayout.astro";

export async function getStaticPaths() {
    const experiments = await getCollection("experiments");
    return experiments.map((experiment) => ({
        params: { id: experiment.id },
        props: { experiment },
    }));
}

const { experiment } = Astro.props;
const { Content } = await render(experiment);
---

<MarkdownExperimentLayout frontmatter={experiment.data}>
    <Content />
</MarkdownExperimentLayout>
