---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ExperimentDetail from "../../components/ExperimentDetail.astro";

export async function getStaticPaths() {
    const experiments = await getCollection("experiments");
    return experiments.map((experiment) => ({
        params: { id: experiment.id },
        props: { experiment },
    }));
}

const { experiment } = Astro.props;
const { Content } = await render(experiment);
---

<BaseLayout title={experiment.data.title}>
    <div class="container">
        <ExperimentDetail experiment={experiment} Content={Content} />
    </div>
</BaseLayout>
