---
import { getCollection, render } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import ExperimentDetail from "../../components/ExperimentDetail.astro";

export async function getStaticPaths() {
    const experiments = await getCollection("experiments");
    return experiments.map((experiment) => ({
        params: { id: experiment.id },
        props: { experiment },
    }));
}

const { experiment } = Astro.props;
const { Content } = await render(experiment);
---

<ContentLayout title={experiment.data.title}>
    <ExperimentDetail experiment={experiment} Content={Content} />
</ContentLayout>
