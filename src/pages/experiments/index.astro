---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const allExperiments = await getCollection("experiments");
const sortedExperiments = allExperiments.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Experiments">
    <div class="container">
        <section class="section">
            <h1>Experiments</h1>
            <p class="intro">
                Creative coding sketches, UX observations, and explorations in
                interactive design.
            </p>
        </section>
        <section class="experiments-grid">
            {
                sortedExperiments.map((experiment) => (
                    <article class="card">
                        {experiment.data.cover && (
                            <img
                                src={experiment.data.cover}
                                alt={experiment.data.title}
                                class="card__image"
                            />
                        )}
                        <div class="card__content">
                            <h2 class="card__title">
                                <a href={`/experiments/${experiment.id}`}>
                                    {experiment.data.title}
                                </a>
                            </h2>
                            <p class="card__description">
                                {experiment.data.description}
                            </p>
                            <div class="card__meta">
                                <time
                                    datetime={experiment.data.pubDate.toISOString()}
                                >
                                    {experiment.data.pubDate.toLocaleDateString(
                                        "en-US",
                                        {
                                            year: "numeric",
                                            month: "long",
                                        },
                                    )}
                                </time>
                                <span class="status-badge status-badge--{experiment.data.status}">
                                    {experiment.data.status}
                                </span>
                            </div>
                            {experiment.data.tags &&
                                experiment.data.tags.length > 0 && (
                                    <div class="card__tags">
                                        {experiment.data.tags.map((tag) => (
                                            <span class="tag">{tag}</span>
                                        ))}
                                    </div>
                                )}
                        </div>
                    </article>
                ))
            }
        </section>
    </div>
</BaseLayout>

<style>
    .intro {
        font-size: 1.125rem;
        color: rgba(0, 0, 0, 0.7);
        max-width: 600px;
        margin-bottom: 3rem;
    }

    .cards-grid {
        display: grid;
        gap: 2rem;
    }

    .card {
        background: var(--white);
        border: 1px solid rgba(0, 0, 0, 0.08);
        overflow: hidden;
        transition: transform 0.3s ease;
    }

    .card:hover {
        transform: translateY(-4px);
    }

    .status {
        padding: 0.25rem 0.75rem;
        background: var(--sage);
        color: var(--navy);
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
</style>
