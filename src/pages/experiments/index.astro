---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ExperimentsList from "../../components/ExperimentsList.astro";

const allExperiments = await getCollection("experiments");
const sortedExperiments = allExperiments.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Experiments">
        <ExperimentsList experiments={sortedExperiments} />
</BaseLayout>
