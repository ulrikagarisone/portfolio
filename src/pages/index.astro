---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PersonalitySection from "../components/PersonalitySection.astro";

const allProjects = await getCollection("projects");
const featuredProjects = allProjects
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);

const allExperiments = await getCollection("experiments");
const recentExperiments = allExperiments
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);
---

<BaseLayout title="Ulrika Garisone - UX & Creative Developer">
	<PersonalitySection />
</BaseLayout>
