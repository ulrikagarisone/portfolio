---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const allProjects = await getCollection("projects");
const featuredProjects = allProjects
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const allExperiments = await getCollection("experiments");
const recentExperiments = allExperiments
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<BaseLayout title="Home">
	<div class="container">
		<section class="hero">
			<h1>Ulrika Garisone</h1>
			<p class="hero__intro">
				I design interfaces that move, respond, and feel alive.
			</p>
			<p class="hero__description">
				UX researcher and creative developer based in Belgium, blending
				behavior observation with motion-driven interaction design.
			</p>
			<div class="hero__buttons">
				<a href="/projects" class="btn btn--primary">View Projects</a>
				<a href="/about" class="btn">About Me</a>
			</div>
		</section>

		<section class="section">
			<div class="section-header">
				<h2>Selected Work</h2>
				<a href="/projects" class="link--underline">View all →</a>
			</div>

			<div class="cards-grid">
				{
					featuredProjects.map((project) => (
						<article class="card">
							<img
								src={project.data.cover}
								alt={project.data.title}
							/>
							<div class="card-content">
								<h3>
									<a href={`/projects/${project.id}`}>
										{project.data.title}
									</a>
								</h3>
								<p>{project.data.description}</p>
								<div class="tags">
									{project.data.tags
										.slice(0, 3)
										.map((tag) => (
											<span class="tag">{tag}</span>
										))}
								</div>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<!-- Experiments -->
		<section class="section">
			<div class="section-header">
				<h2>Recent Experiments</h2>
				<a href="/experiments" class="link--underline">View all →</a>
			</div>

			<div class="cards-grid">
				{
					recentExperiments.map((experiment) => (
						<article class="card">
							<img
								src={experiment.data.cover}
								alt={experiment.data.title}
							/>
							<div class="card-content">
								<h3>
									<a href={`/experiments/${experiment.id}`}>
										{experiment.data.title}
									</a>
								</h3>
								<p>{experiment.data.description}</p>
								<div class="tags">
									{experiment.data.tags
										.slice(0, 3)
										.map((tag) => (
											<span class="tag">{tag}</span>
										))}
								</div>
							</div>
						</article>
					))
				}
			</div>
		</section>
	</div>
</BaseLayout>
<style>
	.intro {
		font-size: 1.125rem;
		color: rgba(0, 0, 0, 0.7);
		max-width: 600px;
		margin-bottom: 3rem;
	}

	.cards-grid {
		display: grid;
		gap: 2rem;
	}

	.card {
		background: var(--white);
		border: 1px solid rgba(0, 0, 0, 0.08);
		overflow: hidden;
		transition: transform 0.3s ease;
	}

	.card:hover {
		transform: translateY(-4px);
	}

	.card img {
		width: 100%;
		height: 200px;
		object-fit: cover;
	}

	.card-content {
		padding: 1.5rem;
	}

	.card h2 {
		font-size: 1.5rem;
		margin-bottom: 0.75rem;
	}

	.card h2 a {
		color: var(--navy);
		transition: color 0.3s ease;
	}

	.card h2 a:hover {
		color: var(--teal);
	}

	.card p {
		color: rgba(0, 0, 0, 0.7);
		line-height: 1.6;
		margin-bottom: 1rem;
	}

	.meta {
		display: flex;
		gap: 1rem;
		align-items: center;
		margin-bottom: 1rem;
		font-size: 0.9375rem;
	}

	.meta time {
		color: rgba(0, 0, 0, 0.6);
	}

	.status {
		padding: 0.25rem 0.75rem;
		background: var(--sage);
		color: var(--navy);
		border-radius: 4px;
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
</style>
