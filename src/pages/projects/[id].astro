---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { id: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await project.render();
---

<BaseLayout title={project.data.title}>
    <div class="container">
        <article class="project-detail">
            <header class="project-header">
                <a href="/projects" class="back-link">← Back to Projects</a>

                <h1>{project.data.title}</h1>

                <div class="project-meta">
                    <time datetime={project.data.pubDate.toISOString()}>
                        {
                            project.data.pubDate.toLocaleDateString("en-US", {
                                year: "numeric",
                                month: "long",
                                day: "numeric",
                            })
                        }
                    </time>
                    <span
                        class="status-badge status-badge--{project.data.status}"
                    >
                        {project.data.status}
                    </span>
                </div>

                {
                    project.data.tags && project.data.tags.length > 0 && (
                        <div class="project-tags">
                            {project.data.tags.map((tag) => (
                                <span class="tag">{tag}</span>
                            ))}
                        </div>
                    )
                }
            </header>

            <div class="project-content">
                <Content />
            </div>
        </article>
    </div>
</BaseLayout>
<style>
    .project-detail {
        max-width: 800px;
        margin: 0 auto;
    }

    .project-header {
        margin-bottom: 3rem;
    }

    .back-link {
        display: inline-block;
        color: var(--teal);
        font-weight: 600;
        margin-bottom: 1.5rem;
        transition: transform 0.3s ease;
    }

    .back-link:hover {
        transform: translateX(-4px);
    }

    .project-header h1 {
        margin-bottom: 1rem;
        color: var(--navy);
    }

    .project-meta {
        display: flex;
        gap: 1rem;
        align-items: center;
        margin-bottom: 1rem;
        font-size: 0.9375rem;
    }

    .project-meta time {
        color: rgba(0, 0, 0, 0.6);
    }

    .status-badge {
        padding: 0.25rem 0.75rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .status-badge--completed {
        background: var(--sage);
        color: var(--navy);
    }

    .status-badge--in-progress {
        background: var(--peach);
        color: var(--navy);
    }

    .status-badge--archived {
        background: rgba(0, 0, 0, 0.1);
        color: rgba(0, 0, 0, 0.6);
    }

    .project-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .project-content {
        line-height: 1.8;
    }

    .project-content :global(h2) {
        color: var(--navy);
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        font-size: 1.75rem;
    }

    .project-content :global(h3) {
        color: var(--navy);
        margin-top: 2rem;
        margin-bottom: 0.75rem;
        font-size: 1.375rem;
    }

    .project-content :global(img) {
        width: 100%;
        height: auto;
        border-radius: 8px;
        margin: 2rem 0;
    }

    .project-content :global(p) {
        margin-bottom: 1.25rem;
        color: rgba(0, 0, 0, 0.85);
    }

    .project-content :global(ul),
    .project-content :global(ol) {
        margin-bottom: 1.5rem;
        padding-left: 2rem;
    }

    .project-content :global(li) {
        margin-bottom: 0.5rem;
        color: rgba(0, 0, 0, 0.85);
    }

    .project-content :global(a) {
        color: var(--teal);
        font-weight: 600;
        text-decoration: underline;
        text-decoration-color: rgba(14, 137, 146, 0.3);
        transition: all 0.3s ease;
    }

    .project-content :global(a:hover) {
        text-decoration-color: var(--teal);
    }

    .project-content :global(table) {
        width: 100%;
        border-collapse: collapse;
        margin: 2rem 0;
    }
</style>
